[Unit]
Description=TunBridge privileged local tunnel service
After=local-fs.target network.target

[Service]
Type=simple
ExecStart=/usr/libexec/tunbridge/tunbridge-service-linux run
User=root
Group=root
UMask=0077
RuntimeDirectory=tunbridge
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
StateDirectory=tunbridge
StateDirectoryMode=0700
# The engine must outlive the service process: killing it with the service
# would send traffic directly. A restarted service adopts the running engine.
KillMode=process
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
